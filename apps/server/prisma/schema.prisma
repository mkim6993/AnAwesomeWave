generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String        @id @default(cuid())
  username         String        @unique
  displayname      String?
  createdAt        DateTime      @default(now())

  // back-relations
  organizedParties Party[]       @relation("PartyOrganizer")
  participations   Participant[]
}

enum PartyStatus {
  SCHEDULED
  LIVE
  ENDED
}

model Party {
  id           String        @id @default(cuid())
  name         String
  joinCode     String        @unique
  status       PartyStatus   @default(LIVE)
  organizerId  String
  createdAt    DateTime      @default(now())
  
  // Relations
  organizer    User          @relation("PartyOrganizer", fields: [organizerId], references: [id])
  participants Participant[]
}

enum ParticipantRole {
  OPERATOR
  GUEST
}

model Participant {
  id         String          @id @default(cuid())
  partyId    String
  userId     String?
  guestToken String?
  role       ParticipantRole @default(GUEST)
  joinedAt   DateTime        @default(now())
  
  // Relations
  party      Party           @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Constraints
  @@unique([partyId, userId])
  @@unique([partyId, guestToken])
  
  // Indexes for common queries
  @@index([userId])
  @@index([partyId])
}
